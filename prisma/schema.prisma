generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// pg_trgm backs the GIN trigram indexes below — Postgres's native answer to
// fast `contains`/ILIKE substring search (see /search's query shape), without
// standing up a separate search service.
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ---------- Identity ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Set the moment an emailed OTP is successfully verified for this address —
  // never cleared afterward, same convention as phoneVerifiedAt below. A
  // password-only signup never sets this (no verification step exists there).
  emailVerifiedAt DateTime?
  passwordHash String
  name         String
  username     String   @unique
  avatarUrl    String?
  // Its own login identifier (see lib/actions/phone-auth.ts) as well as a
  // shipping/contact field — canonical +63XXXXXXXXXX form, set by
  // normalizePhPhone. @unique is nullable-safe (Postgres allows any number of
  // NULL rows), so an account that has never verified a phone just has null here.
  phone          String?   @unique
  // Set the moment an OTP is successfully verified for this number — never
  // cleared afterward. This is what a future phone-required gate (e.g. COD)
  // should check, rather than just phone != null, since phone alone doesn't
  // prove the account actually holds that number.
  phoneVerifiedAt DateTime?
  role         String   @default("BUYER") // BUYER | SELLER | ADMIN
  // Bumped to immediately invalidate every existing session for this user —
  // checked against the JWT's own copy on every request (see lib/auth.config.ts).
  // A mismatch signs the user out even though their token hasn't expired yet.
  sessionVersion Int    @default(0)
  bio          String?
  area         String? // persisted mirror of the area cookie for logged-in users, so local notifications can be targeted server-side
  interests    Json     @default("[]") // string[] of interest slugs (see lib/interests.ts) — optional, non-blocking onboarding
  createdAt    DateTime @default(now())

  sellerProfile     SellerProfile?
  addresses         Address[]
  cart              Cart?
  ordersAsBuyer     Order[]         @relation("BuyerOrders")
  notifications     Notification[]
  follows           Follow[]        @relation("UserFollows")
  chatMessages      ChatMessage[]
  auctionBids       AuctionBid[]
  productBids       ProductBid[]
  claimSlots        ClaimSlot[]
  reviews           Review[]        @relation("BuyerReviews")
  reviewVotes       ReviewVote[]
  reportsFiled      Report[]        @relation("Reporter")
  reportsReviewed   Report[]        @relation("ReportReviewedBy")
  savedProducts     SavedProduct[]
  streamReminders   StreamReminder[]
  messagesSent      Message[]
  threadsAsBuyer    MessageThread[] @relation("ThreadBuyer")
  disputesRaised    Dispute[]       @relation("DisputeRaisedBy")
  blockedUsers      BlockedUser[]   @relation("Blocker")
  blockedByUsers    BlockedUser[]   @relation("Blocked")
  pushSubscriptions PushSubscription[]
  eventInterests    EventInterest[]
  dropReminders     DropReminder[]
  lookingForPosts   LookingForPost[]
  collections       UserCollection[]
  supportTickets    SupportTicket[]
  adminAuditLogs    AdminAuditLog[]
  passwordResetTokens PasswordResetToken[]
  offersMade          Offer[] @relation("OffersMade")
  twoFactorAuth     TwoFactorAuth?
  coupons           Coupon[]

  // Opted into ATBP marketing emails — required before a promotional coupon
  // (e.g. first-purchase) can be issued to this account. See lib/services/coupons.ts.
  marketingOptIn Boolean @default(false)

  // ---------- Local notification categories (Phase 5) ----------
  notifyLocalDrops    Boolean @default(true)
  notifyLocalEvents   Boolean @default(true)
  notifyNearbySellers Boolean @default(true)

  // ---------- Wishlist notification categories ----------
  notifyWishlistPriceDrop Boolean @default(true)
  notifyWishlistRestock   Boolean @default(true)
  notifyWishlistLowStock  Boolean @default(true)

  searchLogs SearchLog[]
}

// Append-only log of executed searches — powers "Based on your searches" on the
// homepage. Logged-out searches are recorded with userId: null so aggregate
// popularity signals stay possible later without ever inventing per-user history.
model SearchLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A one-way block: blocker no longer sees messages from / can be messaged by blocked.
model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// Failed login attempts, kept only long enough to enforce the rolling rate
// limit in lib/auth.ts. A row is written per failed attempt and read back as
// a count within the window — no scheduled cleanup, same append-only-log
// pattern as ProductEvent.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Web Push subscription (VAPID) — no third-party push service account needed,
// this talks directly to the browser vendor's own push endpoint.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  city       String
  province   String
  postalCode String
  isDefault  Boolean @default(false)
}

model SellerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName      String
  handle        String   @unique
  description   String?
  story         String? // longer About-tab narrative — how the shop started, what makes it distinct
  bannerUrl     String?
  logoUrl       String?
  verified      Boolean  @default(false)
  badges        Json     @default("[]") // string[] subset of VERIFIED_SELLER, VERIFIED_MAKER, VERIFIED_PRELOVED, AUTHENTICATED
  // True only for the small set of pre-launch example shops kept around so
  // Discover isn't empty on day one of the beta — never set on a real seller
  // signup. Every public surface that shows a shop must render the "Sample
  // Shop" notice from isSampleContent, never silently treat this content as
  // genuine buyer/seller activity. See docs on the beta-launch data cleanup.
  isSampleContent Boolean @default(false)
  status        String   @default("PENDING") // PENDING | APPROVED | SUSPENDED | CLOSED
  // ---------- Voluntary closure ----------
  // Distinct from SUSPENDED (admin-initiated, for-cause) — CLOSED is the
  // seller's own choice to stop selling, via closeStoreAction or its
  // admin-assisted counterpart. Closing archives every ACTIVE listing (see
  // closeStoreAction) so nothing lingers in discovery; reopenStoreAction can
  // bring the shop itself back, but listings must be reactivated individually.
  closedAt      DateTime?
  closeReason   String?
  rating        Float    @default(0)
  ratingCount   Int      @default(0)
  totalSales    Int      @default(0)
  followerCount Int      @default(0)
  province      String? // used as the seller's general "area" for local discovery — a city/municipality, not a street address
  announcement  String? // short shop banner message, e.g. "New pieces going up Saturday"
  socialLinks   Json     @default("{}") // { facebook?, instagram?, tiktok? }
  returnPolicy  String? // seller-authored — shown on the shop page and every one of their product pages
  createdAt     DateTime @default(now())

  // ---------- Seller identity (individual vs. registered business) ----------
  // Declared at application time; birVerified is admin-set only, after
  // actually checking the seller's BIR Certificate of Registration — never
  // inferred or self-certified. Gates the Founding Seller Program (see below).
  sellerKind            String  @default("INDIVIDUAL") // INDIVIDUAL | BUSINESS
  birRegistrationNumber String? // seller-declared BIR Certificate of Registration (COR) number
  birVerified           Boolean @default(false)
  businessLicenseUrl    String? // uploaded BIR COR document backing birRegistrationNumber — verifyBirLicenseAction
  // requires this to be set before birVerified can be granted; a typed number alone is no longer enough.

  // ---------- Identity (KYC) verification — every seller kind, not just business ----------
  // Collected at signup (see becomeSellerAction / becomeClosetSellerAction /
  // becomeYardSaleSellerAction / becomeCasualServiceSellerAction) so ATBP has
  // a real ID on file before money moves through a seller's account, not just
  // a self-declared shop name. idDocumentUrl is admin-review-only — never
  // rendered on any public-facing page. See idVerificationBlockMessage in
  // lib/constants.ts for how an unverified/rejected ID affects new listings.
  idDocumentType   String? // PHILSYS_ID | PASSPORT | DRIVERS_LICENSE | UMID | POSTAL_ID | VOTERS_ID
  idDocumentUrl    String?
  selfiePhotoUrl   String? // live camera selfie, taken alongside the ID — same admin-review-only handling as idDocumentUrl
  idSubmittedAt    DateTime?
  idVerified       Boolean   @default(false)
  idVerifiedAt     DateTime?
  idRejectedReason String?

  // ---------- Founding Seller Program (launch promotion, first 200 approved sellers) ----------
  // Granted exactly once, atomically, the first moment a profile is BOTH
  // status=APPROVED and a BIR-verified business (see maybeGrantFoundingSeller
  // in lib/services/founding-seller.ts) — whichever of approval or BIR
  // verification happens second is what triggers the grant.
  // Permanent once true — never revoked by a later downgrade or subscription change.
  foundingSeller            Boolean   @default(false)
  foundingSellerNumber      Int?      @unique // 1-200, assigned in approval order
  foundingSellerStartDate   DateTime? // = the approval moment that granted this, not account creation
  foundingSellerProEndDate  DateTime? // startDate + 6 months — free Pro-equivalent benefits end here
  foundingPremiumEligible   Boolean   @default(false)
  foundingPremiumPrice      Float?    // snapshot of the founding price at grant time — see Coupon's snapshot pattern
  foundingPremiumCommission Float?

  // ---------- Local / physical presence (Phase 1) ----------
  physicalPresence   String   @default("ONLINE_ONLY") // ONLINE_ONLY | HOME_STUDIO | PHYSICAL_STORE | MARKET_VENDOR | WORKSHOP | MULTIPLE_LOCATIONS
  publicAddress      String? // only ever shown if showExactAddress is true — otherwise `province` (area) is all that's public
  showExactAddress   Boolean  @default(false)
  mapLat             Float?
  mapLng             Float?
  pickupAvailable    Boolean  @default(false)
  pickupInstructions String? // shown to buyers; kept seller-wide and simple for now rather than a full pickup-locations system
  temporarilyClosed  Boolean  @default(false)

  // ---------- Local delivery (Phase 5) ----------
  localDeliveryAvailable Boolean @default(false)
  localDeliveryFee       Float?
  localDeliveryAreas     Json    @default("[]") // string[] subset of AREAS this seller personally delivers to

  // ---------- Primary category declaration (onboarding) ----------
  // Informational only — powers search/filtering, never enforced against what
  // a seller actually lists. Official picks are Category slugs; anything not
  // in the taxonomy goes to CategoryTagSuggestion instead, for admin review.
  primaryCategories Json @default("[]") // string[] of Category.slug

  // sellerTier itself is never stored — it's derived live from birVerified +
  // the active SellerSubscription (see getSellerTier in lib/services/seller-tier.ts)
  // so it can't drift from what's actually enforced.

  categoryTagSuggestions CategoryTagSuggestion[]
  warnings               SellerWarning[]

  // ---------- Casual selling: My Closet / My Yard Sale ----------
  // One Closet per seller (the ongoing "stuff I own and don't want" pool);
  // many YardSales over time but at most one ACTIVE at once (enforced in
  // createYardSaleAction, not here — a seller can have several ENDED ones).
  // My Shop (regular Product listings with neither closetId nor yardSaleId
  // set) requires birVerified — see createProductAction.
  closet    Closet?
  yardSales YardSale[]
  offers    Offer[]

  // ---------- Casual selling: ATBP Services (Service + Digital Product listings) ----------
  // Its own cap pool, separate from Closet's — a casual seller gets 20 active
  // Service+DigitalProduct listings combined and a 50-completed-sale monthly
  // cap, independent of whatever they're doing in My Closet/Yard Sale. Same
  // pause-at-cap + 2-consecutive-months-over BIR nudge shape as Closet's
  // fields above, just tracked seller-wide since Service/Digital listings
  // have no container model the way Closet items do.
  casualListingCapStreak     Int     @default(0)
  casualListingLastCapMonth  String? // "YYYY-MM", UTC
  casualListingCapNudgeShown Boolean @default(false)

  products     Product[]
  livestreams  Livestream[]
  drops        Drop[]
  payouts      Payout[]
  hours        ShopHours[]
  locations    SellerLocation[]
  lookingForReplies LookingForReply[]
  collectionEntries CollectionSeller[]
  userCollectionItems UserCollectionItem[]
  followers    Follow[]        @relation("SellerFollowers")
  reviews      Review[]        @relation("SellerReviews")
  ordersAsSeller Order[]       @relation("SellerOrders")
  threads      MessageThread[] @relation("ThreadSeller")
  promoCodes   PromoCode[]
  subscription      SellerSubscription?
  planOverride       SellerPlanOverride?
  commissions        Commission[]
  promotions         Promotion[]
  promotionalCredits PromotionalCredit[]
  eventParticipation EventSeller[]
  organizedEvents    Event[]             @relation("EventOrganiserSeller")

  // "Approved sellers in this city" is the standard shape for every local-
  // discovery query (see lib/services/local.ts).
  @@index([status, province])
  // /search does `contains`/ILIKE on shop name and handle.
  @@index([shopName(ops: raw("gin_trgm_ops"))], type: Gin, name: "SellerProfile_shopName_trgm_idx")
  @@index([handle(ops: raw("gin_trgm_ops"))], type: Gin, name: "SellerProfile_handle_trgm_idx")
}

// One row per seller per day of week (0 = Sunday .. 6 = Saturday).
// Holiday/date-specific overrides are deferred beyond Phase 1.
model ShopHours {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0-6
  opensAt     String? // "09:00" — null when closed
  closesAt    String? // "18:00" — null when closed
  closed      Boolean       @default(false)
  open24h     Boolean       @default(false)
  byAppointment Boolean     @default(false)

  @@unique([sellerId, dayOfWeek])
}

// Additional branches for sellers with physicalPresence = MULTIPLE_LOCATIONS.
// The fields on SellerProfile itself (province/publicAddress/pickup*) remain
// the seller's primary/default location — this is purely additive.
model SellerLocation {
  id                 String   @id @default(cuid())
  sellerId           String
  seller             SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  label              String // e.g. "Main Branch", "Weekend Stall"
  province           String
  publicAddress      String?
  showExactAddress   Boolean  @default(false)
  mapLat             Float?
  mapLng             Float?
  pickupAvailable    Boolean  @default(false)
  pickupInstructions String?
  createdAt          DateTime @default(now())

  hours SellerLocationHours[]
}

model SellerLocationHours {
  id            String   @id @default(cuid())
  locationId    String
  location      SellerLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek     Int
  opensAt       String?
  closesAt      String?
  closed        Boolean  @default(false)
  open24h       Boolean  @default(false)
  byAppointment Boolean  @default(false)

  @@unique([locationId, dayOfWeek])
}

// Freeform "Other" category tags sellers submit at onboarding/settings when
// none of the official categories fit — informational only, never enforced
// against what a seller actually lists. An admin reviews these to decide
// whether to promote one into the real Category taxonomy.
model CategoryTagSuggestion {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  tag       String
  status    String        @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime      @default(now())
}

// A prohibited-item strike against a seller's account, created only by
// flagProhibitedItemAction (admin-only). 3 active warnings auto-suspends the
// account pending manual review — see suspendSellerAction/reinstateSellerAction
// in lib/actions/admin.ts. `active: false` means an admin cleared it; the row
// stays for history, it just stops counting toward the suspension threshold.
// Warnings never expire on their own.
model SellerWarning {
  id              String        @id @default(cuid())
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId       String? // the flagged listing, if it still exists
  productTitle    String // denormalized snapshot so the warning stays legible even after the product is gone
  reason          String
  issuedByAdminId String
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
}

// "My Closet" — a seller's ongoing personal-resale pool, the low-friction
// alternative to opening a Shop. One per seller. Its own monthly-sales cap
// (50/month) replaces the old CASUAL-tier seller-wide cap; streak fields
// here are scoped to the Closet specifically, not the seller overall, same
// reasoning as why YardSale items don't share a cap with Closet items.
model Closet {
  id       String        @id @default(cuid())
  sellerId String        @unique
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  title       String
  city        String? // PH location, matches SellerProfile.province's usage
  description String?
  featured    Boolean @default(false) // admin-toggled "Staff picks" flag

  monthlyCapStreak Int     @default(0) // consecutive calendar months (UTC) the 50-sold cap was hit
  lastCapHitMonth  String? // "YYYY-MM", UTC
  capNudgeShown    Boolean @default(false) // re-arms if the streak breaks

  createdAt DateTime @default(now())

  products Product[]

  @@index([city])
  @@index([featured])
}

// "My Yard Sale" — a time-boxed clear-out event, 1 day to 1 month. Auto-
// archives (itself and its products) once endDate passes — see
// expireOverdueYardSales in lib/services/yard-sale.ts (no cron in this app,
// so this is a lazy check called from high-traffic read paths).
model YardSale {
  id       String        @id @default(cuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  title       String
  city        String?
  description String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("ACTIVE") // ACTIVE | ENDED | CLOSED_EARLY

  createdAt DateTime @default(now())

  products Product[]

  @@index([status, city])
  @@index([status, endDate])
  @@index([sellerId, status])
}

// A buyer's public request for something they're hoping to find — sellers
// browse these and reply if they have (or can make) a match.
model LookingForPost {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  area        String?
  budgetMin   Float?
  budgetMax   Float?
  status      String   @default("OPEN") // OPEN | FULFILLED | CLOSED
  createdAt   DateTime @default(now())

  replies LookingForReply[]
}

model LookingForReply {
  id        String   @id @default(cuid())
  postId    String
  post      LookingForPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  message   String
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

// ---------- Catalog ----------

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  icon     String
  order    Int     @default(0)
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products        Product[]
  lookingForPosts LookingForPost[]
}

model Product {
  id                String   @id @default(cuid())
  sellerId          String
  seller            SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  title             String
  description       String
  images            Json     // string[]
  videoUrl          String?
  price             Float
  compareAtPrice    Float?
  quantity          Int
  quantityAvailable Int
  type              String   @default("HANDMADE") // HANDMADE | PRE_LOVED | VINTAGE | COLLECTIBLE | ART | CUSTOM
  condition         String   @default("BRAND_NEW") // BRAND_NEW | LIKE_NEW | EXCELLENT | GOOD | FAIR
  sku               String?
  status            String   @default("ACTIVE") // DRAFT | ACTIVE | SOLD_OUT | REMOVED | FLAGGED | PAUSED_CAP | ARCHIVED
  sellingModes      Json     // string[] subset of BUY_NOW, CLAIM, AUCTION
  listingType       String   @default("FIXED") // FIXED | AUCTION
  // ---------- ATBP Services: what this listing actually is ----------
  // Orthogonal to listingType (FIXED/AUCTION is about pricing mechanism; kind
  // is about what's being sold). PHYSICAL is every pre-existing listing —
  // goods, made-to-order, food, closet/yard-sale items. SERVICE listings
  // always carry 1-3 ServicePackage rows instead of using price/quantity
  // directly; DIGITAL_PRODUCT listings use digitalFileUrls (below) instead of
  // the legacy single digitalFileUrl. See lib/actions/services.ts and
  // lib/actions/digital-products.ts.
  kind              String   @default("PHYSICAL") // PHYSICAL | SERVICE | DIGITAL_PRODUCT
  // Seller's own attestation, at listing time, that they own or are licensed
  // to sell what they're listing here — required (non-null) before a SERVICE
  // or DIGITAL_PRODUCT listing can go ACTIVE. Never required/shown for
  // PHYSICAL listings.
  rightsAttestedAt  DateTime?
  shippingInfo      String?
  likeCount         Int      @default(0)
  viewCount         Int      @default(0)
  featured          Boolean  @default(false) // seller-curated "featured" spot on their own shop page
  tags              Json     @default("[]") // string[] of interest slugs (see lib/interests.ts) — drives Explore/Gifts/collections
  soldCount         Int      @default(0) // display-only realistic "sold" count, independent of live order history
  createdAt         DateTime @default(now())

  // Local — fulfillment options (Phase 1, Phase 5)
  shippingAvailable      Boolean @default(true)
  pickupAvailable        Boolean @default(false)
  localDeliveryAvailable Boolean @default(false)
  // Per-product narrowing of the seller's own localDeliveryAreas — null means
  // "every area the seller delivers to"; a non-null subset lets a seller offer
  // local delivery more broadly but restrict a specific item (e.g. perishable
  // food, or something too bulky to send far) to a smaller zone.
  localDeliveryAreas     Json? // string[] subset of SellerProfile.localDeliveryAreas

  // Digital products — mutually exclusive with physical fulfillment in practice;
  // checkout skips shipping/pickup entirely once every item in an order is digital.
  isDigital                   Boolean @default(false)
  digitalFileUrl              String?
  digitalDeliveryInstructions String?
  // kind="DIGITAL_PRODUCT" only — Vercel Blob URLs of the seller-uploaded
  // file(s) (see the "digital-file" upload kind in api/upload/route.ts).
  // Never shown directly to a buyer — see DigitalDownloadToken, the only
  // sanctioned way a buyer ever reaches one of these URLs.
  digitalFileUrls              Json?   // string[]

  // Made-to-order — a structured attribute rather than a services listing;
  // the product is still bought like any other, just produced after ordering.
  madeToOrder               Boolean @default(false)
  productionTimeDays        Int?
  customizationOptions      Json    @default("[]") // string[] of option labels, e.g. ["Color", "Size", "Text on tag"]
  personalizationInstructions String?
  maxOrderQuantity          Int?

  // Food & Snacks — structured facts only shown when isFood is set; this is a
  // shelf-stable packaged-goods marketplace, never fresh/hot food delivery.
  isFood               Boolean @default(false)
  shelfStable          Boolean @default(false)
  expiryInfo           String? // e.g. "Best consumed within 6 months of purchase"
  ingredients          String?
  allergens            String? // e.g. "Contains peanuts, soy, dairy"
  foodShippingNotes    String? // e.g. "Ships via air only — not sent to areas with 3+ day transit"

  // Deals — scheduled discount window. Effective price is computed at read
  // time (see lib/deals.ts) rather than mutated by a background job.
  dealPrice   Float?
  dealStartAt DateTime?
  dealEndAt   DateTime?

  // ---------- Casual selling: My Closet / My Yard Sale ----------
  // At most one of these is ever set — a product belongs to a Closet, a
  // YardSale, or neither (a regular My Shop listing), never more than one.
  // Enforced in the create actions, not at the schema level.
  closetId         String?
  closet           Closet?   @relation(fields: [closetId], references: [id], onDelete: SetNull)
  yardSaleId       String?
  yardSale         YardSale? @relation(fields: [yardSaleId], references: [id], onDelete: SetNull)
  // Closet-only staleness check-in (90 days) — set to now() at creation and
  // reset whenever the seller confirms "still have it"; staleNudgeSentAt
  // guards against re-notifying every time the lazy check runs before the
  // seller has acted on the last nudge.
  closetConfirmedAt  DateTime?
  staleNudgeSentAt   DateTime?

  // ---------- Tawad (make-an-offer) — Closet/Yard Sale listings only ----------
  // tawadFloor is the seller's hidden auto-decline minimum: never sent to the
  // buyer in any API response (see toTawadPublicView in lib/services/tawad.ts,
  // the only place allowed to read it). tawadCeiling is optional and, unlike
  // the floor, safe to expose if ever needed since meeting it just auto-accepts.
  tawadEnabled  Boolean @default(false)
  tawadFloor    Float?
  tawadCeiling  Float?

  auction            ProductAuction?
  livestreamProducts LivestreamProduct[]
  dropProducts        DropProduct[]
  orderItems         OrderItem[]
  cartItems          CartItem[]
  savedBy            SavedProduct[]
  events             ProductEvent[]
  reports            Report[] @relation("ProductReports")
  reviews            Review[]
  promotions         Promotion[]
  lookingForReplies  LookingForReply[]
  collectionEntries  CollectionProduct[]
  userCollectionItems UserCollectionItem[]
  offers             Offer[]
  servicePackages    ServicePackage[]

  // Covers the real browse/filter shapes this app actually runs: category
  // pages, a seller's own shop, closet/yard-sale item lists, the
  // services/digital-products browse, and the generic "status + recency"
  // fallback used almost everywhere else. Added once the catalog was large
  // enough that these were full table scans — see lib/services/discovery.ts,
  // lib/trending.ts, and the seller/closet/yard-sale/deals pages.
  // Studio management pages (Products, Inventory, Deals, Auctions) filter by
  // sellerId alone or combined with a non-equality/non-status predicate
  // (status: { not: "REMOVED" }, dealPrice: { not: null }, listingType), which
  // the status-led composite indexes below can't serve — this covers those.
  @@index([sellerId])
  @@index([status, categoryId, createdAt])
  @@index([status, sellerId, createdAt])
  @@index([status, closetId, createdAt])
  @@index([status, yardSaleId, createdAt])
  @@index([status, kind, createdAt])
  @@index([status, createdAt])
  @@index([status, likeCount])
  // /search runs `contains`/ILIKE on these — a plain btree index can't serve
  // substring search, so these are GIN trigram indexes instead (pg_trgm).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, name: "Product_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, name: "Product_description_trgm_idx")
}

// ---------- Tawad (make-an-offer / haggle) ----------
// Private 1:1 negotiation between one buyer and the seller over one listing.
// Each fresh offer the buyer submits is its own row (reofferCount tracks which
// attempt this is, capped at TAWAD_MAX_OFFERS_PER_BUYER in lib/services/tawad.ts);
// a seller counter updates this same row rather than creating a new one, since
// spec keeps it to one counter round per thread. On acceptance, agreedPrice is
// fed into a normal BUY_NOW cart item (see acceptOffer in lib/services/tawad.ts)
// so checkout, commission, and the buyer protection fee all run through their
// existing, unmodified code paths at that price.
model Offer {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User     @relation("OffersMade", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  amount        Float    // the buyer's offer currently on the table
  counterAmount Float?   // the seller's counter, if they made one
  agreedPrice   Float?   // set once ACCEPTED — either `amount` or `counterAmount`
  status        String   @default("PENDING") // PENDING | AUTO_DECLINED | DECLINED | COUNTERED | ACCEPTED | EXPIRED | LAPSED
  reofferCount  Int      // which attempt this is for this buyer+product (1..TAWAD_MAX_OFFERS_PER_BUYER)

  // PENDING/COUNTERED expire after TAWAD_OFFER_EXPIRY_HOURS if not acted on.
  expiresAt     DateTime?
  // Set only once ACCEPTED — the buyer has until this time to pay before the
  // reservation lapses and the item returns to available (see expireStaleOffers).
  reservedUntil DateTime?

  orderId       String?  @unique
  order         Order?   @relation(fields: [orderId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId, buyerId])
}

// ---------- ATBP Services: custom online work (Part A) ----------
// Up to 3 fixed-price tiers per SERVICE-kind Product — no custom-quote flow.
model ServicePackage {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tier              String   // BASIC | STANDARD | PREMIUM
  price             Float
  deliverables      String   // seller-authored "what's included" text
  deliveryDays      Int
  revisionsIncluded Int
  order             Int      @default(0) // display order (Basic, then Standard, then Premium)

  serviceOrders ServiceOrder[]

  @@unique([productId, tier])
}

// One per Order with fulfillmentMethod "SERVICE" — the escrow/delivery/
// revision state machine. Funds release exactly like a goods order (see
// getSellerWallet in lib/services/analytics.ts): Order.status "DELIVERED"
// counts as pending, "COMPLETED" counts as available — this reuses that
// bucketing rather than adding a parallel escrow-status concept.
model ServiceOrder {
  id        String          @id @default(cuid())
  orderId   String          @unique
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packageId String?
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  // Snapshotted from the package at purchase time so a later package edit (or
  // the package itself being deleted) never changes what this order promised.
  packageTier       String
  deliveryDays      Int
  revisionsIncluded Int
  revisionsUsed     Int     @default(0)

  requirementsBrief String? // buyer-submitted, right after ordering
  status            String  @default("AWAITING_BRIEF") // AWAITING_BRIEF | IN_PROGRESS | DELIVERED | REVISION_REQUESTED | COMPLETED

  // Set once the brief is submitted (createdAt-of-brief + deliveryDays) — purely
  // informational (shown to both sides), not itself enforced against.
  dueAt DateTime?
  // Set on each (re)delivery; buyer has AUTO_CONFIRM_DAYS to act before this
  // auto-completes, same window/mechanism as a goods delivery (see
  // lib/shipping/lifecycle.ts) — the lazy sweep for services lives in
  // lib/services/service-orders.ts instead, since there's no Shipment here.
  deliveredAt      DateTime?
  autoConfirmAt    DateTime?
  buyerConfirmedAt DateTime?

  createdAt DateTime @default(now())

  deliveries ServiceDelivery[]
}

// One row per delivery attempt (the first delivery, then one more per
// requested revision) — keeps a real history for disputes ("was it delivered
// on time, what did each round actually contain") rather than overwriting.
model ServiceDelivery {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  fileUrls       Json         @default("[]") // string[]
  message        String?
  createdAt      DateTime     @default(now())
}

// ---------- ATBP Services: digital products (Part B) ----------
// The only sanctioned way a buyer ever reaches a DIGITAL_PRODUCT's uploaded
// file — never the raw Product.digitalFileUrls directly. Same plain-token-as-
// lookup-key convention as PasswordResetToken/guest tracking tokens; unlike
// those this one also tracks a use count, since a download link is meant to
// be reusable a handful of times (re-downloading after losing the file)
// rather than single-use.
model DigitalDownloadToken {
  id            String    @id @default(cuid())
  orderItemId   String
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  token         String    @unique
  expiresAt     DateTime
  downloadCount Int       @default(0)
  maxDownloads  Int       @default(10)
  createdAt     DateTime  @default(now())
  // Admin kill-switch, distinct from natural expiry/exhaustion — e.g. a link
  // leaked publicly, or a buyer dispute resolved against them after the file
  // was already issued. See adminRevokeDigitalDownloadTokenAction.
  revoked       Boolean   @default(false)
}

// ---------- Marketplace auctions (standalone, not tied to a livestream) ----------

model ProductAuction {
  id            String   @id @default(cuid())
  productId     String   @unique
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  startingBid   Float
  reservePrice  Float?
  currentBid    Float
  bidCount      Int      @default(0)
  minIncrement  Float    @default(50)
  startAt       DateTime @default(now())
  endAt         DateTime
  status        String   @default("ACTIVE") // ACTIVE | ENDED | CANCELLED
  winningBidId  String?
  winnerUserId  String?
  reserveMet    Boolean  @default(false)
  purchasedAt   DateTime?
  buyNowPrice   Float?   // optional: pay this to end the auction immediately and win
  extensionCount Int     @default(0) // anti-sniping: bumped each time a late bid pushes endAt back
  startNotifiedAt DateTime? // set once "starting soon" watchers have been notified that bidding opened
  endingSoonNotifiedAt DateTime? // set once wishlist watchers have been notified this auction is ending soon
  createdAt     DateTime @default(now())

  bids ProductBid[]
}

model ProductBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   ProductAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  createdAt DateTime @default(now())

  @@index([auctionId, amount])
}

// ---------- Trending signals ----------
// Append-only engagement log. Trending scores are always derived from this
// at read time (lib/trending.ts) — there is no editable "trending score"
// field for a seller to tamper with, and a seller's own actions on their
// own listings are never logged here.

model ProductEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String   // VIEW | SAVE | CART_ADD | BID | PURCHASE
  userId    String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  // The trending engagement scan (computeTrendingScores) filters only by
  // createdAt across the whole table — the composite index above can't serve
  // that (it leads with productId), so this covers it separately.
  @@index([createdAt])
}

// ---------- Drops (limited releases) ----------

model Drop {
  id          String   @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverImage  String
  releaseAt   DateTime
  status      String   @default("UPCOMING") // UPCOMING | LIVE | ENDED
  liveNotifiedAt DateTime? // set once reminder-holders + followers have been notified that this drop went live
  createdAt   DateTime @default(now())

  products  DropProduct[]
  reminders DropReminder[]
  userCollectionItems UserCollectionItem[]

  @@index([status, releaseAt])
  @@index([sellerId])
}

// A user asking to be notified when one specific drop goes live — distinct
// from following the seller generally (see toggleDropReminderAction).
model DropReminder {
  id        String   @id @default(cuid())
  dropId    String
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([dropId, userId])
}

model DropProduct {
  id                String @id @default(cuid())
  dropId            String
  drop              Drop    @relation(fields: [dropId], references: [id], onDelete: Cascade)
  productId         String
  product           Product @relation(fields: [productId], references: [id])
  quantityAvailable Int     @default(1)
  order             Int     @default(0)
}

// ---------- Curated discovery collections ("ATBP Picks", seasonal collections) ----------
// Deliberately hand-curated rather than rule-based, so the site can carry a
// human "we found this for you" voice — CollectionProduct/CollectionSeller
// rows are exactly what an admin dashboard would manage.
model Collection {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  subtitle  String?
  emoji     String?
  type      String   @default("PICK") // PICK | SEASONAL | SHOPS
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  products CollectionProduct[]
  sellers  CollectionSeller[]
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  order        Int        @default(0)

  @@unique([collectionId, productId])
}

model CollectionSeller {
  id           String        @id @default(cuid())
  collectionId String
  collection   Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order        Int           @default(0)

  @@unique([collectionId, sellerId])
}

// ---------- User-created collections (buyer boards — "save to a list", not the
// admin-curated Collection/ATBP-Picks model above) ----------
model UserCollection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  items UserCollectionItem[]
}

// Exactly one of productId/sellerId/dropId is set per row — a product save
// (including auctions, which are just products), a shop save, or a drop save.
model UserCollectionItem {
  id           String         @id @default(cuid())
  collectionId String
  collection   UserCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId     String?
  seller       SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dropId       String?
  drop         Drop?          @relation(fields: [dropId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@unique([collectionId, productId])
  @@unique([collectionId, sellerId])
  @@unique([collectionId, dropId])
}

// ---------- Markets (digital storefronts for real-world maker markets) ----------

model Market {
  id        String   @id @default(cuid())
  name      String
  city      String
  tagline   String?
  imageUrl  String
  schedule  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
}

// ---------- Livestreams ----------

model Livestream {
  id            String   @id @default(cuid())
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  category      String
  thumbnailUrl  String
  status        String   @default("SCHEDULED") // SCHEDULED | LIVE | ENDED | CANCELLED
  scheduledAt   DateTime
  startedAt     DateTime?
  endedAt       DateTime?
  viewerCount   Int      @default(0)
  peakViewers   Int      @default(0)
  likeCount     Int      @default(0)
  shareCount    Int      @default(0)
  createdAt     DateTime @default(now())

  products      LivestreamProduct[]
  chatMessages  ChatMessage[]
  reminders     StreamReminder[]
  reports       Report[] @relation("LivestreamReports")
}

model StreamReminder {
  id           String   @id @default(cuid())
  livestreamId String
  livestream   Livestream @relation(fields: [livestreamId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([livestreamId, userId])
}

model LivestreamProduct {
  id           String   @id @default(cuid())
  livestreamId String
  livestream   Livestream @relation(fields: [livestreamId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  order        Int      @default(0)
  mode         String   // BUY_NOW | CLAIM | AUCTION
  status       String   @default("QUEUED") // QUEUED | ACTIVE | SOLD_OUT | ENDED
  startPrice   Float?
  minIncrement Float?
  durationSec  Int?
  featuredAt   DateTime?
  endedAt      DateTime?

  claimSlots ClaimSlot[]
  auction    Auction?
  cartItems  CartItem[]
}

model ClaimSlot {
  id                  String   @id @default(cuid())
  livestreamProductId String
  livestreamProduct   LivestreamProduct @relation(fields: [livestreamProductId], references: [id], onDelete: Cascade)
  slotNumber          Int
  status              String   @default("AVAILABLE") // AVAILABLE | CLAIMED | CANCELLED
  claimedByUserId     String?
  claimedByUser       User?    @relation(fields: [claimedByUserId], references: [id])
  claimedAt           DateTime?

  cartItem CartItem?

  @@unique([livestreamProductId, slotNumber])
}

model Auction {
  id                  String   @id @default(cuid())
  livestreamProductId String   @unique
  livestreamProduct   LivestreamProduct @relation(fields: [livestreamProductId], references: [id], onDelete: Cascade)
  startPrice          Float
  currentBid          Float
  minIncrement        Float
  quantity            Int      @default(1)
  endsAt              DateTime
  status              String   @default("RUNNING") // RUNNING | ENDED | CANCELLED
  winnerUserId        String?
  winningBid          Float?

  bids AuctionBid[]
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  createdAt DateTime @default(now())
}

model ChatMessage {
  id           String   @id @default(cuid())
  livestreamId String
  livestream   Livestream @relation(fields: [livestreamId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  authorName   String
  authorAvatar String?
  body         String
  type         String   @default("MESSAGE") // MESSAGE | SYSTEM | BID | CLAIM | JOIN
  createdAt    DateTime @default(now())
}

// ---------- Cart / Orders ----------

model Cart {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]
}

model CartItem {
  id                  String   @id @default(cuid())
  cartId              String
  cart                Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  quantity            Int      @default(1)
  unitPrice           Float
  sourceType          String   @default("MARKETPLACE") // MARKETPLACE | LIVE | CLAIM | AUCTION
  livestreamProductId String?
  livestreamProduct   LivestreamProduct? @relation(fields: [livestreamProductId], references: [id])
  claimSlotId         String?  @unique
  claimSlot           ClaimSlot? @relation(fields: [claimSlotId], references: [id])
  personalizationNote String? // buyer-entered customization/personalization for made-to-order items
  addedAt             DateTime @default(now())
}

model Order {
  id                 String   @id @default(cuid())
  orderNumber        String   @unique
  // Null for a guest checkout order — see lib/actions/guest-checkout.ts. Guest
  // identity/contact instead lives in guestEmail/guestPhone below; claimed
  // (buyerId backfilled) the moment they sign up or log in with that same
  // email — see claimGuestOrders in lib/services/guest-checkout.ts.
  buyerId            String?
  buyer              User?    @relation("BuyerOrders", fields: [buyerId], references: [id])
  guestEmail         String?
  guestPhone         String?
  // Plain unique token, same convention as PasswordResetToken — mailed once,
  // never re-displayed, lets a guest reach /orders/track without an account.
  // Regenerating (see requestGuestTrackingLinkAction) overwrites and so
  // invalidates whatever link was issued before.
  guestTrackingToken           String?   @unique
  guestTrackingTokenExpiresAt  DateTime?
  sellerId           String
  seller             SellerProfile @relation("SellerOrders", fields: [sellerId], references: [id])
  subtotal           Float
  shippingFee        Float    @default(0)
  // Charged to the buyer only on prepaid orders (never COD) — funds refund
  // eligibility through the existing Dispute flow. min(subtotal*3% + 10, 150),
  // see buyerProtectionFeeFor in lib/fees.ts. Stored per-order (not derived)
  // since the formula/rate could change later and past orders must keep what
  // they actually charged.
  buyerProtectionFee Float    @default(0)
  // The buyer's own checkbox choice at checkout — kept distinct from
  // buyerProtectionFee (which can independently be 0 on a COD order even
  // when this is true, since COD is fee-exempt) so "did they ask for it" and
  // "did they end up covered" don't get conflated. Defaults false to match
  // BUYER_PROTECTION_DEFAULT_ON in lib/fees.ts.
  buyerProtectionOptIn Boolean @default(false)
  total              Float
  status             String   @default("PAYMENT_PENDING")
  // SHIP | PICKUP | LOCAL_DELIVERY | DIGITAL | SERVICE | DIGITAL_PRODUCT.
  // PICKUP is pickup directly from the seller (see SellerProfile.pickupAvailable)
  // — ATBP operates no pickup locations of its own. DIGITAL is the legacy
  // single-link isDigital path; DIGITAL_PRODUCT is the new secure-upload +
  // download-token path (see DigitalDownloadToken). SERVICE has its own
  // escrow/delivery/revision state machine — see ServiceOrder.
  fulfillmentMethod  String   @default("SHIP")
  // Which active shipping-layer provider (see lib/shipping/registry.ts) the
  // order was fulfilled through — "MANUAL"/a courier id for SHIP, "PICKUP"
  // for seller pickup. This is what createShipmentForOrder/createPickupShipment
  // books the actual Shipment against.
  shippingProviderId String?
  paymentMethod      String   @default("MOCK")
  paymentStatus      String   @default("PENDING")
  shippingName       String
  shippingPhone      String
  shippingAddress    String
  shippingCity       String
  shippingProvince   String
  shippingPostalCode String
  discountAmount     Float    @default(0)
  promoCodeId        String?
  promoCode          PromoCode? @relation(fields: [promoCodeId], references: [id])
  couponId             String?
  coupon               Coupon?  @relation(fields: [couponId], references: [id])
  couponDiscountAmount Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  // Set exactly once, on the first transition into DELIVERED or COMPLETED —
  // this (not createdAt) is what the CASUAL-tier monthly-sales cap buckets
  // by, since "completed sales this month" means fulfilled this month, not
  // placed this month. See syncMonthlySalesCap in lib/services/seller-tier.ts.
  deliveredAt        DateTime?

  items            OrderItem[]
  payment          Payment?
  review           Review?
  dispute          Dispute?
  redemption       PromoRedemption?
  couponRedemption CouponRedemption?
  commission       Commission?
  supportTickets   SupportTicket[]
  shipment         Shipment?
  offer            Offer?
  serviceOrder     ServiceOrder?
  fraudFlags       FraudFlag[]

  @@index([sellerId, createdAt])
  @@index([buyerId, createdAt])
  @@index([deliveredAt])
}

// ---------- Shipping (see lib/shipping) ----------
// Provider-agnostic: every courier adapter (manual, Ninja Van, ...) implements
// ShippingProvider and writes into this same model, normalizing its own
// status vocabulary into the shared enum below. Only ever created for
// fulfillmentMethod "SHIP" orders — pickup/local-delivery/digital have no
// courier and stay on the seller's own manual status control.
model Shipment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerId    String   // MANUAL | NINJAVAN | ... — see lib/shipping/registry.ts
  courierName   String?  // seller-entered/preset for manual; the provider's own carrier name once integrated
  trackingNumber String?
  providerRef   String?  // the courier's own shipment/order id, for integrated providers (unused by manual)
  // Shared internal status every adapter normalizes into — the rest of the
  // app (returns/payout, order UI) only ever reads this, never a courier's
  // own vocabulary.
  status        String   @default("PENDING") // PENDING | IN_TRANSIT | DELIVERED | FAILED_DELIVERY | RETURNED
  declaredValue Float?   // parcel value declared to the courier (insurance/COD basis)
  shippedAt     DateTime?
  // First-class because the returns/payout system's 7-day window and fund
  // release key off this — set by courier webhook (integrated) or by
  // buyerConfirmedAt/autoConfirmAt (manual). See lib/shipping/lifecycle.ts.
  deliveredAt   DateTime?
  buyerConfirmedAt DateTime? // set only if the buyer tapped "Order received" themselves
  // Computed once at ship time (shippedAt + N days) and checked lazily (no
  // cron in this app) — see AUTO_CONFIRM_DAYS in lib/shipping/lifecycle.ts.
  autoConfirmAt DateTime?

  // ---------- COD (only meaningful when the provider has supportsCOD=true) ----------
  // Null/unused for manual shipments and non-COD orders.
  codAmount           Float?
  codCollectionStatus String?  // PENDING | COLLECTED | FAILED | REMITTED
  codRemittance       CodRemittance?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per courier COD remittance batch/payout matched to a shipment — lets
// a later reconciliation job match what the courier actually paid ATBP against
// what was declared, before releasing the seller's net. Ninja Van's ~2.75%
// COD handling fee is tracked here for visibility but is platform-absorbed
// per business decision, not deducted from the seller — see codHandlingFeeRate
// in lib/shipping/providers/ninjavan.ts.
model CodRemittance {
  id              String    @id @default(cuid())
  shipmentId      String    @unique
  shipment        Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  amountCollected Float?
  handlingFee     Float?
  amountRemitted  Float?
  reference       String?
  status          String    @default("PENDING") // PENDING | RECONCILED | DISCREPANCY
  remittedAt      DateTime?
  createdAt       DateTime  @default(now())
}

// ---------- Promo codes (seller-scoped checkout discounts) ----------

model PromoCode {
  id              String    @id @default(cuid())
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  code            String    // stored uppercase
  discountType    String    // PERCENT | FIXED
  discountValue   Float
  minSubtotal     Float?
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  perUserLimit    Int       @default(1)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  orders      Order[]
  redemptions PromoRedemption[]

  @@unique([sellerId, code])
}

model PromoRedemption {
  id             String    @id @default(cuid())
  promoCodeId    String
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId         String
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Float
  createdAt      DateTime  @default(now())
}

// ---------- Reusable slot-limited campaign counter ----------
// Backs any "first N people get X" seller-acquisition promotion (Founding
// Seller today; a future launch/referral/category campaign reuses this same
// row shape). One row per campaign id. Slots are claimed with a single
// `UPDATE ... SET count = count + 1 WHERE count < limit RETURNING count` —
// atomic under Postgres row locking, so two concurrent approvals can never
// both win the same numbered slot or overrun the limit.
model PromotionCounter {
  id        String   @id // e.g. "FOUNDING_SELLER"
  count     Int      @default(0)
  limit     Int
  updatedAt DateTime @updatedAt
}

// ---------- Platform coupons (buyer-facing promotion engine) ----------
// A modular, campaign-driven system distinct from PromoCode above: PromoCode
// is a seller-typed code a buyer enters manually; a Coupon here is issued
// automatically to one specific user by a CouponCampaign (first-purchase
// welcome offer today, seller/category/referral/flash-sale campaigns later)
// and applies platform-wide without the buyer typing anything.

model CouponCampaign {
  id            String    @id @default(cuid())
  code          String    @unique // stable machine key, e.g. "FIRST_PURCHASE"
  name          String
  discountType  String    // PERCENT | FIXED
  discountValue Float
  maxDiscount   Float?    // cap in pesos, e.g. 100 for a 10%-up-to-₱100 offer
  minSubtotal   Float?
  scope         String    @default("PLATFORM") // PLATFORM | SELLER | CATEGORY
  eligibility   String    @default("NEW_CUSTOMER") // NEW_CUSTOMER | ALL | REFERRAL
  requiresMarketingOptIn Boolean @default(false)
  active        Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  coupons Coupon[]
}

model Coupon {
  id         String   @id @default(cuid())
  campaignId String
  campaign   CouponCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String   @unique

  // Snapshotted from the campaign at issue time so a later campaign edit
  // never changes the value of a coupon a user already holds.
  discountType  String
  discountValue Float
  maxDiscount   Float?
  minSubtotal   Float?

  status     String    @default("ACTIVE") // ACTIVE | USED | EXPIRED | REVOKED
  claimedAt  DateTime  @default(now())
  usedAt     DateTime?
  expiresAt  DateTime?

  orders      Order[]
  redemptions CouponRedemption[]

  @@index([userId])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId         String
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Float
  createdAt      DateTime @default(now())
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  title      String
  imageUrl   String
  unitPrice  Float
  quantity   Int
  sourceType String  @default("BUY_NOW")
  personalizationNote String? // snapshot of the buyer's customization/personalization input at order time

  digitalDownloadTokens DigitalDownloadToken[]

  @@index([productId])
  @@index([orderId])
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String   @default("MOCK") // MOCK | GCASH | MAYA | CARD | COD
  status      String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  amount      Float
  providerRef String?
  createdAt   DateTime @default(now())
}

model Payout {
  id          String    @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount      Float
  // Flat ₱99 when instant is true, 0 otherwise — see INSTANT_PAYOUT_FEE in
  // lib/fees.ts. Deducted from `amount` to get what the seller actually
  // receives; `amount` itself still reflects the seller's full requested
  // withdrawal so wallet/balance math (getSellerWallet) doesn't change.
  feeAmount   Float     @default(0)
  instant     Boolean   @default(false)
  status      String    @default("PENDING") // PENDING | PROCESSING | PAID | FAILED
  method      String    @default("BANK") // BANK | GCASH | MAYA
  destination String
  requestedAt DateTime  @default(now())
  processedAt DateTime?
}

// ---------- Social ----------

model Follow {
  id                 String   @id @default(cuid())
  followerId         String
  follower           User     @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  sellerId           String
  seller             SellerProfile @relation("SellerFollowers", fields: [sellerId], references: [id], onDelete: Cascade)
  notifyNewProducts  Boolean  @default(true)
  notifyNewAuctions  Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@unique([followerId, sellerId])
  @@index([sellerId])
}

model SavedProduct {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceAtSave Float? // snapshot of the effective price when saved, so a real drop can be shown later
  createdAt   DateTime @default(now())

  @@unique([userId, productId])
  // Restock/price-drop/low-stock wishlist notifications and auction-watcher
  // lookups all filter by productId alone (fired on every such event) — not
  // served by the (userId, productId) unique index above since productId
  // isn't its leading column.
  @@index([productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  linkUrl   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // The notifications inbox and unread-count queries both filter by userId
  // (the latter also on read) and the inbox orders by createdAt — this table
  // had no index at all despite every notify() call inserting into it.
  @@index([userId, createdAt])
}

model MessageThread {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     User     @relation("ThreadBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    SellerProfile @relation("ThreadSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages Message[]

  @@unique([buyerId, sellerId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())
  readAt    DateTime?
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    SellerProfile @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  productId String?  // which item in the order this review is actually about
  product   Product? @relation(fields: [productId], references: [id])
  buyerId   String
  buyer     User     @relation("BuyerReviews", fields: [buyerId], references: [id])
  rating    Int
  comment   String?
  photos    Json     @default("[]") // string[] of uploaded photo URLs
  createdAt DateTime @default(now())

  // ---------- Admin moderation ----------
  // Hidden reviews are excluded from public display AND from the seller's
  // rating/ratingCount aggregate (see recomputeSellerRating in
  // lib/services/reviews.ts) — a hidden fake review must not keep inflating
  // a seller's score. The row itself is kept (not deleted) so there's a
  // record of what was hidden and why; use deleteReviewAction for a hard
  // delete instead (e.g. spam/abuse with no legitimate reason to retain it).
  hidden       Boolean   @default(false)
  hiddenReason String?
  hiddenAt     DateTime?
  hiddenById   String? // admin User.id who hid it

  // ---------- "Was this helpful?" voting ----------
  // Denormalized counters (kept in sync by voteReviewAction, same pattern as
  // SellerProfile.rating/ratingCount) so rendering a list of reviews never
  // needs a per-review aggregate query. ReviewVote is the source of truth —
  // these two columns are a cache of it.
  helpfulCount    Int @default(0)
  notHelpfulCount Int @default(0)
  votes           ReviewVote[]

  // ---------- Seller response ----------
  // One response per review, from that review's own seller — a 1:1 field on
  // the row itself rather than a separate table, since a review only ever
  // gets a single, editable reply.
  sellerResponse    String?
  sellerRespondedAt DateTime?

  @@index([sellerId, createdAt])
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful   Boolean // true = "Helpful", false = "Not helpful"
  createdAt DateTime @default(now())

  // One vote per user per review — voting again with the same or the
  // opposite choice updates this row rather than creating a second one.
  @@unique([reviewId, userId])
  @@index([reviewId])
}

// ---------- Trust & Safety ----------

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  reporter     User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   String   // PRODUCT | LIVESTREAM | USER | SELLER
  productId    String?
  product      Product? @relation("ProductReports", fields: [productId], references: [id])
  livestreamId String?
  livestream   Livestream? @relation("LivestreamReports", fields: [livestreamId], references: [id])
  targetLabel  String   // human readable label of what's being reported
  reason       String
  details      String?
  status       String   @default("OPEN") // OPEN | REVIEWED | RESOLVED | DISMISSED | ACTIONED
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?
  // Set together with resolvedAt whenever an admin moves a report out of OPEN
  // — ACTIONED specifically means this report led to flagProhibitedItemAction
  // being called (RA 11967 listing-report flow); RESOLVED covers everything
  // else an admin handled without that automated flag/warning/suspend path.
  reviewedById String?
  reviewedBy   User?    @relation("ReportReviewedBy", fields: [reviewedById], references: [id])

  // One report per user per listing — same reporter can still report a
  // different SELLER/LIVESTREAM/USER target freely since productId is null
  // there (Postgres treats each NULL as distinct, so this only constrains
  // PRODUCT-targeted reports).
  @@unique([reporterId, productId])
}

model Dispute {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Null when raised by a guest via their magic-link tracking page — the
  // order's own guestEmail is who to reach, same pattern as
  // SupportTicket.userId.
  raisedById  String?
  raisedBy    User?     @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  reason      String
  details     String
  status      String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED_REFUND | RESOLVED_DENIED | CLOSED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

// Automated, rule-based fraud signals — not a block, a review queue. See
// evaluateOrderForFraud in lib/services/fraud.ts, called right after order
// creation. orderId/buyerId/sellerId are all optional because a future rule
// might flag a pattern (e.g. a seller's cancellation rate) that isn't tied
// to one specific order.
model FraudFlag {
  id           String    @id @default(cuid())
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId      String?
  sellerId     String?
  type         String    // NEW_ACCOUNT_HIGH_VALUE | RAPID_ORDERING | REPEAT_CANCELLATIONS | COD_ABUSE_RISK
  severity     String    // LOW | MEDIUM | HIGH
  reason       String
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?

  @@index([resolvedAt, createdAt])
  @@index([buyerId])
  @@index([sellerId])
}

// Customer-service contact form submissions — separate from Report (which is
// for flagging a specific product/seller/livestream for moderation). userId
// is nullable so a logged-out visitor can still reach support.
model SupportTicket {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  email      String
  topic      String    // ORDER | PAYMENT | ACCOUNT | SELLING | OTHER
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  message    String
  status     String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

// ============================================================
// Monetization — seller plans, limits, commissions, promotions,
// advertising, and events.
//
// Ownership/access control note: this app has no Supabase/RLS layer —
// every table below is guarded the same way the rest of the schema
// already is, with every server action re-deriving `sellerId` from the
// authenticated session and scoping all reads/writes by it (see
// lib/actions/*). Admin-only mutations go through requireAdmin() in
// lib/actions/admin.ts. That pattern has already been security-reviewed
// for this codebase, so new tables follow it rather than introducing a
// second, inconsistent access-control mechanism.
//
// Usage counting note: active-listing/active-auction/monthly/weekly
// counts are deliberately NOT stored as incrementable counters here —
// they're computed live from Product/ProductAuction in
// lib/services/seller-plan.ts (getSellerUsage). A maintained counter
// can drift from reality (exactly the "sold, deleted, expired" edge
// cases this feature has to get right); a live COUNT query at this
// app's scale is cheap and can never be wrong.
// ============================================================

// ---------- Seller plans & limits ----------

model SellerPlan {
  id                      String   @id @default(cuid())
  code                    String   @unique // FREE | PRO
  name                    String
  monthlyPrice            Float
  transactionFeePercent   Float // e.g. 6 = 6%
  maxActiveListings       Int
  maxNewListingsPerMonth  Int
  maxAuctionsPerWeek      Int
  maxActiveAuctions       Int
  maxProductsPerAuction   Int      @default(1)
  features                Json     @default("[]") // string[] feature flags, e.g. ["ADVANCED_ANALYTICS","COUPONS","BULK_TOOLS","SELLER_BADGE","PRIORITY_SUPPORT"]
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  subscriptions SellerSubscription[]
}

// One active row per seller. Upgrading/downgrading is a plan change on
// this row today; when Xendit is wired in, `provider`/`providerRef`
// give it somewhere real to record the payment reference without a
// schema change.
model SellerSubscription {
  id                 String    @id @default(cuid())
  sellerId           String    @unique
  seller             SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  planId             String
  plan               SellerPlan @relation(fields: [planId], references: [id])
  status             String    @default("ACTIVE") // ACTIVE | CANCELLED | PAST_DUE
  provider           String    @default("MOCK") // MOCK | XENDIT
  providerRef        String?
  startedAt          DateTime  @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Admin-grantable per-seller exceptions to their plan's limits — the
// "reward a trusted seller" lever called for without building full
// seller tiers yet. Any null field falls back to the seller's plan.
model SellerPlanOverride {
  id                            String   @id @default(cuid())
  sellerId                      String   @unique
  seller                        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  activeListingLimitOverride    Int?
  monthlyListingLimitOverride   Int?
  weeklyAuctionLimitOverride    Int?
  activeAuctionLimitOverride    Int?
  reason                        String?
  createdByUserId               String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

// ---------- Commission ----------
// One row per completed order, written at order-creation time so the
// rate that applied at the moment of sale is preserved forever — later
// changing SellerPlan.transactionFeePercent never touches past orders.
model Commission {
  id               String   @id @default(cuid())
  orderId          String   @unique
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  planCodeAtSale   String
  ratePercent      Float
  subtotal         Float
  commissionAmount Float
  // Flat ₱15 fee on Card/Online Banking orders only — GCash, Maya, and QR Ph
  // carry no processing fee. See lib/services/commission.ts.
  processingFee    Float    @default(0)
  sellerProceeds   Float
  createdAt        DateTime @default(now())

  @@index([sellerId, createdAt])
}

// ---------- Promotions (seller-purchased placements) ----------
// Admin-configurable price bands for every paid placement ATBP sells —
// both seller product promotions (category PRODUCT) and event
// promotions (category EVENT) share this table so pricing management
// lives in one place.
model PromotionType {
  id          String   @id @default(cuid())
  category    String   // PRODUCT | EVENT
  code        String   @unique // BOOST | FEATURED | CATEGORY_FEATURE | HOMEPAGE_FEATURE | SPONSORED_CAMPAIGN | EVENT_FEATURED | EVENT_PROMOTED | EVENT_MAJOR_CAMPAIGN | EVENT_SPONSORSHIP
  name        String
  description String?
  minPrice    Float
  maxPrice    Float
  unit        String   // PER_LISTING | PER_WEEK | PER_CAMPAIGN
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  promotions      Promotion[]
  eventPromotions EventPromotion[]
}

model Promotion {
  id              String   @id @default(cuid())
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotionTypeId String
  promotionType   PromotionType @relation(fields: [promotionTypeId], references: [id])
  price           Float
  placement       String   // HOMEPAGE | CATEGORY | SEARCH | DISCOVER
  categorySlug    String?  // set when placement = CATEGORY
  startAt         DateTime
  endAt           DateTime
  status          String   @default("PENDING") // PENDING | ACTIVE | ENDED | CANCELLED
  paidWithCredits Boolean  @default(false)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([placement, status, startAt, endAt])
}

// Ledger, not a mutable balance — remaining balance is always SUM(amount)
// for non-expired rows, so it can never drift from its own history.
model PromotionalCredit {
  id                 String    @id @default(cuid())
  sellerId           String
  seller             SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount             Float // positive = grant, negative = spend
  source             String // PRO_MONTHLY_GRANT | ADMIN_GRANT | PROMOTION_SPEND | REFUND
  relatedPromotionId String?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([sellerId, createdAt])
}

// ---------- Third-party advertising (kept separate from seller promotions) ----------

model Advertiser {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String
  status       String   @default("PENDING") // PENDING | APPROVED | SUSPENDED
  createdAt    DateTime @default(now())

  campaigns AdCampaign[]
}

model AdCampaign {
  id           String   @id @default(cuid())
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  name         String
  budget       Float?
  status       String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | ENDED
  startAt      DateTime
  endAt        DateTime
  createdAt    DateTime @default(now())

  ads Advertisement[]
}

model Advertisement {
  id               String   @id @default(cuid())
  campaignId       String
  campaign         AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creativeImageUrl String
  destinationUrl   String
  cpc              Float?
  cpm              Float?
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  status           String   @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  createdAt        DateTime @default(now())

  placements AdPlacement[]
}

model AdPlacement {
  id              String   @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  placement       String   // HOMEPAGE | CATEGORY | SEARCH | SELLER_PAGE | EVENT_PAGE
  categorySlug    String?
  createdAt       DateTime @default(now())

  @@index([placement])
}

// ---------- Events (real-world markets & community events) ----------

model Event {
  id                String   @id @default(cuid())
  name              String
  coverImage        String
  description       String
  eventDate         DateTime
  startTime         String? // free-text, e.g. "10:00 AM"
  endTime           String?
  venue             String
  city              String
  address           String?
  admissionPrice    String? // free-text so "Free" / "₱100" / "₱150-₱300" all fit
  websiteUrl        String?
  socialLinks       Json     @default("{}") // { facebook?, instagram?, tiktok? }
  categories        Json     @default("[]") // string[]
  organiserName     String
  organiserSellerId String?
  organiserSeller   SellerProfile? @relation("EventOrganiserSeller", fields: [organiserSellerId], references: [id])
  status            String   @default("UPCOMING") // UPCOMING | LIVE | ENDED | CANCELLED
  createdAt         DateTime @default(now())

  sellers     EventSeller[]
  interests   EventInterest[]
  promotions  EventPromotion[]

  @@index([status, city, eventDate])
}

model EventSeller {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, sellerId])
}

model EventInterest {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // INTERESTED | SAVED
  createdAt DateTime @default(now())

  @@unique([eventId, userId, type])
}

model EventPromotion {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promotionTypeId String
  promotionType   PromotionType @relation(fields: [promotionTypeId], references: [id])
  price           Float
  startAt         DateTime
  endAt           DateTime
  status          String   @default("PENDING") // PENDING | ACTIVE | ENDED | CANCELLED
  createdAt       DateTime @default(now())
}

// ---------- Generic admin-editable pricing config ----------
// Free-form key/value store for pricing knobs that don't warrant their
// own typed column — e.g. "pro_monthly_credit_amount". Value is stored
// as JSON so a config can be a number, string, or small object.
model PricingConfig {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

// ---------- Security: accountability & abuse prevention ----------

// Records every admin mutation for accountability — who did what, to what,
// and when. Written by lib/services/audit-log.ts, never edited or deleted
// by the app itself.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String // e.g. "APPROVE_SELLER", "SUSPEND_USER", "MODERATE_PRODUCT"
  targetType String // e.g. "SellerProfile", "User", "Product"
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

// Generic append-only counter for rate-limiting actions that don't already
// persist an attempt row of their own (promo code checks, reports, guest
// support tickets) — mirrors the LoginAttempt pattern already used for login.
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String // e.g. "promo:<userId>", "report:<userId>", "support:<ip>"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------- Password reset ----------
// The token itself is the lookup key (it's a long random value, not guessable
// by counting attempts) — one row per outstanding reset request.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---------- Phone (mobile OTP) login/register ----------
// One-time SMS code for the phone Credentials provider (see
// lib/actions/phone-auth.ts): if `phone` already belongs to a User this logs
// them in, otherwise it registers a new phone-verified account — same unified
// shape as WhatsApp/Telegram-style phone auth. A 6-digit code is
// brute-forceable if stored plaintext (unlike PasswordResetToken's 32-byte
// token), so it's hashed here, and `attempts` locks a code out after a few
// wrong guesses rather than relying on send-side rate limiting alone.
model PhoneOtpToken {
  id         String    @id @default(cuid())
  phone      String // canonical +63XXXXXXXXXX form — see normalizePhPhone
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// Mirrors PhoneOtpToken exactly, keyed by email instead — see the
// "email-otp" Credentials provider in lib/auth.ts and requestEmailOtpAction
// in lib/actions/email-otp.ts.
model EmailOtpToken {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

// ---------- Admin two-factor auth ----------
// One row per admin who has enabled TOTP. secret is the shared key used to
// generate/verify 6-digit codes; recoveryCodes are one-time-use fallbacks if
// they lose their authenticator app.
model TwoFactorAuth {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret        String
  recoveryCodes Json     @default("[]") // string[] of unused hashed recovery codes
  verifiedAt    DateTime? // set once the user confirms a code during enrollment — null means setup is incomplete
  createdAt     DateTime @default(now())
}
